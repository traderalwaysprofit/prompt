{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prompt-v5",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-02",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "AI_MODEL": "gemini-2.5-flash"
  }
}
